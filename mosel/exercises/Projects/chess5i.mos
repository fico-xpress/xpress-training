model "Chess 5i"
  uses "mmxprs"  
 
  parameters
    DATAFILE='../data/chess5ins.dat'   
  ! DATAFILE="mmodbc.odbc:../data/chess5ins.sqlite"   ! Using SQLite database 
  ! DATAFILE="mmsheet.xls:../data/chess5ins.xls"      ! Generic spreadsheet access
    DEM=50
  end-parameters             

  declarations
    PRODS: range                             ! Index set for products
    RESOURCES: set of string                 ! Index set for resources
    PRODNAME: array(PRODS) of string         ! Product names
    PROFIT: array(PRODS) of real             ! Unit profit
    RESUSE: array(RESOURCES, PRODS) of real  ! Resource usage coefficients
    RESLIM: array(RESOURCES) of real         ! Resource availability
  end-declarations

  procedure readdata
    initializations from DATAFILE          ! Read data from file
      RESUSE [PRODNAME,PROFIT] as "PRODDATA" RESLIM
    end-initializations
  end-procedure

  readdata

  declarations
    produce: array(PRODS) of mpvar           ! Array of decision variables
    LimCtr: array(RESOURCES) of linctr       ! Limit on resource usage constr.
    Demand: linctr                           ! Demand constraint
    TotalProfit: linctr                      ! Objective function
  end-declarations

 ! Constraint definition
  forall(r in RESOURCES)
    LimCtr(r):= sum(i in PRODS) RESUSE(r,i)*produce(i) <= RESLIM(r)        

  Demand:= sum(i in PRODS) produce(i)>=DEM

  forall(i in PRODS) produce(i) is_integer

 ! Objective function
  TotalProfit:=sum(i in PRODS) PROFIT(i)*produce(i)

 ! Problem solving
!  setparam("XPRS_verbose", true)
  maximize(TotalProfit)

 ! Solution reporting
  if getprobstat=XPRS_OPT then
    writeln("Solution: ", getobjval)
    forall(i in PRODS) writeln(strfmt(PRODNAME(i),-10), ": ", produce(i).sol)
  else
    writeln("No solution found")
  end-if  
end-model
