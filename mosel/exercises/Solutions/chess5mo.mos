model "Chess 5s MOO"
 uses "mmxprs"

 parameters
  DATAFILE='../data/chess3.dat'

! DATAFILE="mmsheet.excel:../data/chess2.xls"          ! direct access to Excel
! DATAFILE="mmsheet.xlsx:../data/chess2.xlsx"          ! generic spreadsheet access
! DATAFILE="mmodbc.odbc:../data/chess2.sqlite"         ! SQLite database

 end-parameters

 declarations
  PRODS: set of string                     ! Index set
  DUR, WOOD, PROFIT: array(PRODS) of real  ! Coefficients
 end-declarations

 initializations from DATAFILE             ! Read data from file
  DUR WOOD PROFIT
 end-initializations

 public declarations
  x: array(PRODS) of mpvar                 ! Array of variables
  LimWood, LimCap, Demand, Profit: linctr
  Goals: list of linctr or mpvar           ! Objective functions
 end-declarations

 LimCap:= sum(i in PRODS) DUR(i)*x(i) <= 160        ! Constraint definition
 LimWood:= sum(i in PRODS) WOOD(i)*x(i) <= 200
 forall(i in PRODS) x(i) is_integer

 Demand:= sum(i in PRODS) x(i)                 ! Demand constraint
 Profit:= sum(i in PRODS) PROFIT(i)*x(i)
 Goals:= [Demand,Profit]

! Uncomment to display Solver log
! setparam("XPRS_verbose", true)

! Configuration of objectives: Higher priority values indicate higher priority,
! reltol specifies max. deviation from optimal value
 maximize(Goals,[objconfig("priority=2 reltol=0.05"),objconfig("priority=1")])

 if getprobstat=XPRS_OPT then
   writeln("Solution: profit:", Profit.sol," satisfied demand: ", Demand.sol)
   forall(i in PRODS | x(i).sol>0) writeln(i,": ", x(i).sol)
 else
   writeln("No solution.")
 end-if
 
end-model
