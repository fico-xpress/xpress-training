model "selections"
 uses "mmxprs"

 declarations
  x,y: mpvar
  A: integer
 end-declarations
 
 A:= round(100*(random-0.5))
 
 if A >= 20 then 
  x <= 7
 elif A <= 10 then
  x >= 35
 else
  x = 0
 end-if
  
 case A of 
  -1000..10 : y >= 35
  20..1000 :  y <= 7
  12, 15 :    y = 1
  else        y = 0
 end-case

 loadprob(x+y)
 writeln("A = ", A)
 writeln("x in ", getlb(x), "..", getub(x))
 writeln("y in ", getlb(y), "..", getub(y))

end-model
